    "deploy": "sh scripts/deploy.sh",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:mcp-install": "node scripts/test-mcp-install.mjs",
    "test:mobile": "node scripts/test-mobile.mjs",
    "test:mobile-video": "node scripts/test-mobile-video.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.2",
    "hash-wasm": "^4.12.0",
    "highs": "1.15.3",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
